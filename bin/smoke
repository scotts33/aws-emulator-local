#!/usr/bin/env bash
# Health, account, and create-then-read for S3, DynamoDB, SQS, and SNS.
# Refuses before any AWS call unless AWS_ENDPOINT_URL is the local emulator.
# Resource names are fixed so a second run against the same process still passes.
set -euo pipefail

EXPECTED="https://127.0.0.1:9297"
if [[ "${AWS_ENDPOINT_URL:-}" != "$EXPECTED" ]]; then
  echo "refusing: AWS_ENDPOINT_URL must be ${EXPECTED}" >&2
  exit 2
fi

export AWS_PAGER="${AWS_PAGER:-}"

CA="${AWS_CA_BUNDLE:-${HOME}/.aws/emulator/9297/ca.pem}"
health="$(curl -sf --cacert "$CA" "${EXPECTED}/__admin/health")"
health="$(printf '%s' "$health" | tr -d '\r\n')"
if [[ "$health" != "ok" ]]; then
  echo "health body is not ok: [${health}]" >&2
  exit 1
fi

account="$(aws sts get-caller-identity --query Account --output text)"
if [[ "$account" != "000000000000" ]]; then
  echo "unexpected account: ${account}" >&2
  exit 1
fi

token="smoke-$(date +%s)-$$"
bucket="local-emulator-smoke"
table="local-emulator-smoke"
queue_name="local-emulator-smoke"
topic_name="local-emulator-smoke"

if ! aws s3api head-bucket --bucket "$bucket" >/dev/null 2>&1; then
  aws s3api create-bucket --bucket "$bucket" >/dev/null
fi
tmp="$(mktemp)"
trap 'rm -f "$tmp" "${tmp}.out"' EXIT
printf '%s' "$token" >"$tmp"
aws s3api put-object --bucket "$bucket" --key roundtrip.txt --body "$tmp" >/dev/null
aws s3api get-object --bucket "$bucket" --key roundtrip.txt "${tmp}.out" >/dev/null
s3_got="$(cat "${tmp}.out")"
if [[ "$s3_got" != "$token" ]]; then
  echo "s3 round-trip mismatch" >&2
  exit 1
fi

if ! aws dynamodb describe-table --table-name "$table" >/dev/null 2>&1; then
  aws dynamodb create-table \
    --table-name "$table" \
    --attribute-definitions AttributeName=id,AttributeType=S \
    --key-schema AttributeName=id,KeyType=HASH \
    --billing-mode PAY_PER_REQUEST >/dev/null
fi
status=""
for _ in $(seq 30); do
  status="$(aws dynamodb describe-table --table-name "$table" --query 'Table.TableStatus' --output text)"
  if [[ "$status" == "ACTIVE" ]]; then
    break
  fi
  sleep 1
done
if [[ "$status" != "ACTIVE" ]]; then
  echo "dynamodb table did not become ACTIVE (status=${status})" >&2
  exit 1
fi
aws dynamodb put-item \
  --table-name "$table" \
  --item "{\"id\":{\"S\":\"smoke\"},\"msg\":{\"S\":\"${token}\"}}" >/dev/null
ddb_got="$(aws dynamodb get-item --table-name "$table" --key '{"id":{"S":"smoke"}}' --query 'Item.msg.S' --output text)"
if [[ "$ddb_got" != "$token" ]]; then
  echo "dynamodb round-trip mismatch" >&2
  exit 1
fi

queue_url="$(aws sqs create-queue --queue-name "$queue_name" --query QueueUrl --output text)"
aws sqs send-message --queue-url "$queue_url" --message-body "$token" >/dev/null
sqs_found=0
for _ in $(seq 10); do
  bodies="$(aws sqs receive-message \
    --queue-url "$queue_url" \
    --max-number-of-messages 10 \
    --wait-time-seconds 1 \
    --query 'Messages[].Body' \
    --output text || true)"
  if printf '%s\n' "$bodies" | tr '\t' '\n' | grep -qx -- "$token"; then
    sqs_found=1
    break
  fi
done
if [[ "$sqs_found" != 1 ]]; then
  echo "sqs round-trip mismatch" >&2
  exit 1
fi

topic_arn="$(aws sns create-topic --name "$topic_name" --query TopicArn --output text)"
topic_read="$(aws sns get-topic-attributes --topic-arn "$topic_arn" --query 'Attributes.TopicArn' --output text)"
if [[ "$topic_read" != "$topic_arn" ]]; then
  echo "sns round-trip mismatch" >&2
  exit 1
fi

echo "smoke ok health=${health} account=${account}"
